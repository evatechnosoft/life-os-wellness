DATABASE_URL=postgres://wellness:wellness@localhost:5433/wellness
API_TOKEN=change-me
API_PORT=3011

# Compose Postgres'i. Bos: eski PC degeri. ZimaOS'ta rastgele hex parola + DB yalniz loopback
# (5433 orada dolu): DB_BIND=127.0.0.1:5434
POSTGRES_PASSWORD=
DB_BIND=

# Ev YZ gecidi (ZimaOS yz-litellm). Saglayici anahtari gecitte; burada yalniz wellness'in
# sanal anahtari (ZimaOS: sh /DATA/AppData/yz/anahtar.sh wellness gemini-flash,gemini,yerel).
LLM_BASE_URL=http://yz.evaitec.com:4000/v1
LLM_API_KEY=sk-...
LLM_CHAT_MODEL=gemini-flash
LLM_VISION_MODEL=gemini-flash

# Cloudflare tuneli (fit.evaitec.com). `cloudflared tunnel create wellness` ile uretilen
# kimlik dosyasinin yolu. Bos birakirsan `--profile tunnel` calismaz, uygulama yalniz
# ev aginda erisilebilir kalir. Tunel ayarlari: ops/cloudflared/config.yml
CF_TUNNEL_CREDENTIALS=
