DATABASE_URL=postgres://wellness:wellness@localhost:5433/wellness
API_TOKEN=change-me
API_PORT=3011

# LiteLLM proxy (docker compose up litellm). The app never sees a provider key.
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=proxy
LLM_CHAT_MODEL=wellness-chat
LLM_VISION_MODEL=wellness-vision

# Provider keys - read by the litellm container only, never by the app.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Cloudflare tuneli (fit.evaitec.com). `cloudflared tunnel create wellness` ile uretilen
# kimlik dosyasinin yolu. Bos birakirsan `--profile tunnel` calismaz, uygulama yalniz
# ev aginda erisilebilir kalir. Tunel ayarlari: ops/cloudflared/config.yml
CF_TUNNEL_CREDENTIALS=
