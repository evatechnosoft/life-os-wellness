<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Wear OS 5.1 ve altinda nabiz izni bu. Wear OS 6'da (API 36) yerini
         health.READ_HEART_RATE'e birakiyor, o yuzden ikisi birden bildiriliyor:
         tek basina biri kalirsa saat guncellendigi gun olcum sessizce durur. -->
    <uses-permission android:name="android.permission.BODY_SENSORS" android:maxSdkVersion="35" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_compass"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="true" />

        <!-- Telefon olmadan da kurulup calisir. Yoksa lint WearStandaloneAppFlag ile
             kirmizi kalir ve companion zorunlu gibi davranilir. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- taskAffinity="": Wear'da son kullanilanlar listesinde uygulama kendi
             kartiyla gorunsun (lint WearRecents). Etiket application'dan geliyor. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
